# Server only. Copy to .env.local on the server; never use NEXT_PUBLIC_ for secrets.
DATABASE_URL=file:./dev.db
# Keep zai until a provider and an accessible model have been configured.
LLM_PROVIDER=zai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Google AI Studio key; GEMINI_API_KEY is accepted as an alias.
GOOGLE_API_KEY=
GEMINI_MODEL=
