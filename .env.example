# Server only. Copy to .env.local on the server; never use NEXT_PUBLIC_ for secrets.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1&pool_timeout=20
# Schema changes only; never used for runtime requests.
DIRECT_URL=postgresql://USER:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require&connection_limit=1
# Keep zai until a provider and an accessible model have been configured.
LLM_PROVIDER=zai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Google AI Studio key; GEMINI_API_KEY is accepted as an alias.
GOOGLE_API_KEY=
GEMINI_MODEL=

# Google media: cheapest models only; keys are server-side.
TTS_PROVIDER=google
VIDEO_PROVIDER=google
